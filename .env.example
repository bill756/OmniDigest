# ==============================================================================
# OmniDigest 智能体环境配置
# 复制本文件为 .env 并填入你的 API Key，即可开启真实大模型智能推理与合成
# ==============================================================================

# LLM 与推理配置 (默认兼容 DeepSeek / OpenAI / 通义千问 / 智谱 等任何 OpenAI 规范服务)
OPENAI_API_KEY=sk-your-actual-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
TEMPERATURE=0.3

# 联网搜索核查配置 (可选，若不填则降级为 DuckDuckGo 免 Key 搜索)
# TAVILY_API_KEY=tvly-xxxx

# TypeSafe AI Jev 证据准入门控与质检配置 (可选，若不配置则跳过 Jev 快思考质检)
# TYPESAFE_API_KEY=ts-your-typesafe-api-key-here
# TYPESAFE_ENDPOINT=https://api.typesafe.ai
# TYPESAFE_MODEL=systemone-2024-12-01

# 本地轻量化存储配置 (默认 SQLite，开发测试零门槛)
DATABASE_URL=sqlite+aiosqlite:///./omnidigest.db
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

